# ===============================================
# SALON FINDER BACKEND - ENVIRONMENT CONFIGURATION
# ===============================================

# Node Environment ('development' or 'production')
NODE_ENV=production

# Server Port (Render sets this dynamically, defaults to 5000 locally)
PORT=5000

# MongoDB Connection String (Atlas URI or Local MongoDB)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/salonfinder?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/salonfinder

# JWT Authentication
# Generate a strong 32+ character random string for production
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_12345
JWT_EXPIRE=7d

# Allowed Frontend Origins for CORS (comma-separated for multiple origins)
# Example: https://your-frontend.vercel.app,http://localhost:5173
FRONTEND_URL=https://your-frontend.vercel.app,http://localhost:5173
